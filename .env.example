# Miro App & Marketplace OAuth Configuration
MIRO_ACCESS_TOKEN=your_miro_oauth_access_token_here
MIRO_BOARD_ID=uXjVEekRCSA=
MIRO_CLIENT_ID=your_miro_app_client_id_here
MIRO_CLIENT_SECRET=your_miro_app_client_secret_here
MIRO_REDIRECT_URI=https://qwenarch-canvas.vercel.app/api/oauth/callback

# Vercel KV / Upstash Redis Storage (For multi-tenant installations in serverless)
KV_REST_API_URL=https://your-kv-db.upstash.io
KV_REST_API_TOKEN=your_kv_rest_token_here
INSTALLATION_STORE_PATH=installations.json


# Universal AI Model Configuration (Plug in any model)
AI_PROVIDER=custom
AI_API_KEY=your_model_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o

# --- Popular Provider Examples ---

# 1. OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL_NAME=gpt-4o
# AI_API_KEY=sk-...

# 2. DeepSeek
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL_NAME=deepseek-chat
# AI_API_KEY=sk-...

# 3. ModelScope (Alibaba Qwen Cloud)
# AI_BASE_URL=https://api-inference.modelscope.ai/v1
# AI_MODEL_NAME=Qwen/Qwen3.8-27B
# AI_API_KEY=your_modelscope_key

# 4. OpenRouter / Anthropic Claude
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL_NAME=anthropic/claude-3.5-sonnet
# AI_API_KEY=sk-or-...

# 5. Local Ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL_NAME=qwen2.5-coder:7b
# AI_API_KEY=ollama
